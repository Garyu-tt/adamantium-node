{
  "name": "node-red-contrib-adamantium-construct",
  "version": "0.2.0",
  "private": true,
  "description": "Editor-only native Node-RED Q spawn menu for Adamantium Construct (no flow runtime)",
  "license": "Apache-2.0",
  "keywords": [
    "node-red",
    "adamantium",
    "construct",
    "editor",
    "blueprints",
    "spawn-menu"
  ],
  "node-red": {
    "plugins": {
      "adamantium-native": "native-q-menu.html"
    }
  },
  "files": [
    "native-q-menu.html",
    "resources"
  ],
  "scripts": {
    "check": "node --check resources/core.mjs"
  }
}
